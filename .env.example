# The Muser — Environment Configuration
# Copy this to .env and edit as needed.
# All values shown are defaults — only set what you want to change.

# =====================================================================
# LLM Provider
# =====================================================================
# Options: local (Ollama only), hybrid (free cloud + local), cloud, anthropic
MUSER_LLM_MODE=local

# Ollama (always available as local fallback)
# Default follows MUSER_HARDWARE_PROFILE: qwen3:30b-a3b (24gb) or qwen3:8b (8gb).
# MUSER_OLLAMA_MODEL=qwen3:30b-a3b
OLLAMA_HOST=http://localhost:11434

# Free cloud API keys (optional — enables faster inference)
# GROQ_API_KEY=
# GOOGLE_API_KEY=
# CEREBRAS_API_KEY=

# Anthropic Claude (optional, paid)
# ANTHROPIC_API_KEY=

# =====================================================================
# Hardware profile
# =====================================================================
# auto (default): "8gb" if the detected GPU has < 20 GB VRAM, else "24gb".
# 8gb  -> ACE-Step 1.5 turbo DiT + 0.6B LM, CPU offload, INT8, qwen3:8b,
#         lower VRAM budgets, Ollama unloaded before GPU models load.
# 24gb -> the original full-quality path (sft DiT, qwen3:30b-a3b).
MUSER_HARDWARE_PROFILE=auto
# MUSER_OLLAMA_UNLOAD_BEFORE_GPU=true   # default true on 8gb, false on 24gb

# =====================================================================
# ACE-Step Music Generation
# =====================================================================
MUSER_ACESTEP_VERSION=v15
# Per-setting overrides (defaults come from the hardware profile):
# MUSER_ACESTEP_DIT_MODEL=acestep-v15-turbo
# MUSER_ACESTEP_LM_MODEL=acestep-5Hz-lm-0.6B
# MUSER_ACESTEP_INIT_LM=true            # 5Hz LM; default true on 8gb, false on 24gb
# MUSER_ACESTEP_LM_BACKEND=pt
# MUSER_ACESTEP_LM_DTYPE=float32        # RTX 20xx default; float16 saves VRAM
# MUSER_ACESTEP_OFFLOAD=true
# MUSER_ACESTEP_OFFLOAD_DIT=true
# MUSER_ACESTEP_QUANT=int8_weight_only  # needs torchao; "none" to disable
# MUSER_ACESTEP_COMPILE=false           # torch.compile (needs Triton)
MUSER_ACESTEP_INFER_STEP=50
MUSER_ACESTEP_GUIDANCE=4.0
MUSER_BEST_OF_N=2
# MUSER_ACESTEP_API_URL=          # Set for REST API mode

# =====================================================================
# DiffSinger Vocal Synthesis
# =====================================================================
# Default: griffin-lim (safe, open). Set to fish-hifigan for better quality.
# nsf-hifigan requires MUSER_VOCODER_NC_ACK=true (CC-BY-NC-SA 4.0).
MUSER_DIFFSINGER_VOCODER=griffin-lim
# MUSER_VOCODER_NC_ACK=false

# =====================================================================
# GPU & Audio
# =====================================================================
# Total VRAM in GB. Unset = detected via nvidia-smi. Setting it also drives
# the "auto" hardware profile (e.g. 8 -> 8gb, 24 -> 24gb).
# MUSER_VRAM_GB=24
MUSER_SAMPLE_RATE=44100
MUSER_TARGET_LUFS=-14
MUSER_MP3_BITRATE=320k

# =====================================================================
# Voice Feminization
# =====================================================================
# praat_cli (default, GPL-safe) or parselmouth (GPL v3, user opts in)
MUSER_FEMINIZE_BACKEND=praat_cli

# =====================================================================
# Curation & Export
# =====================================================================
# MUSER_ARTIST_NAME=
# MUSER_COPYRIGHT_HOLDER=
# MUSER_RELEASE_YEAR=2026

# =====================================================================
# Tool Paths (auto-detected, override if needed)
# =====================================================================
# MUSER_LILYPOND_PATH=lilypond
# MUSER_FLUIDSYNTH_PATH=fluidsynth
# MUSER_SFIZZ_PATH=sfizz_render
